<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12: the page color with the mark centered.
     The Flutter splash (lib/app/splash/) draws the same mark in the same
     place, so the hand-over doesn't jump. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
