rules_version = '2';

// Deny by default; tested in the emulator (firestore-tests/) before deploy.
// Layout: TECH_STACK.md §4. Field shapes: ARCHITECTURE.md §8.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isNumberIn(v, lo, hi) {
      return (v is int || v is float) && v >= lo && v <= hi;
    }

    function optionalTimestamp(d, key) {
      return !(key in d) || d[key] is timestamp;
    }

    function validSystem(d) {
      return d.hasSolar is bool
        && d.inverter is map
        && d.inverter.type in ['ups', 'hybrid', 'ongrid']
        && isNumberIn(d.inverter.ratedW, 1, 100000)
        && d.battery is map
        && d.battery.chemistry in ['lead_acid', 'tubular', 'lifepo4']
        && isNumberIn(d.battery.voltage, 1, 1000)
        && isNumberIn(d.battery.ah, 1, 100000)
        && d.battery.count is int && d.battery.count >= 1
        && isNumberIn(d.soc, 0, 1)
        && optionalTimestamp(d, 'socAt')
        && optionalTimestamp(d, 'socCheckedAt')
        && (!('solar' in d) || validSolar(d.solar))
        && (!('location' in d) || validLocation(d.location));
    }

    function validSolar(s) {
      return s is map
        && isNumberIn(s.kWp, 0.05, 1000)
        && s.shading in ['none', 'partial', 'heavy']
        && optionalTimestamp(s, 'lastCleanedAt');
    }

    function validLocation(l) {
      return l is map
        && l.city is string && l.city.size() > 0 && l.city.size() <= 60
        && isNumberIn(l.lat, -90, 90)
        && isNumberIn(l.lon, -180, 180);
    }

    function validAppliance(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && isNumberIn(d.watts, 0, 100000)
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 100
        && isNumberIn(d.dutyCycle, 0.01, 1)
        && d.priority in ['essential', 'comfort', 'avoid_on_backup']
        && d.isOn is bool;
    }

    function optionalNumberIn(d, key, lo, hi) {
      return !(key in d) || isNumberIn(d[key], lo, hi);
    }

    function validOutage(d) {
      return d.startedAt is timestamp
        && (!('endedAt' in d) || d.endedAt == null || d.endedAt is timestamp)
        && d.source in ['manual', 'auto']
        && optionalNumberIn(d, 'startSoC', 0, 1)
        && optionalNumberIn(d, 'endSoC', 0, 1)
        && (!('endSoCSource' in d) || d.endSoCSource in ['estimate', 'user'])
        && optionalNumberIn(d, 'avgLoadW', 0, 100000);
    }

    function validSolarLog(d) {
      return d.date is string && d.date.size() == 10
        && isNumberIn(d.actualKWh, 0, 10000)
        && isNumberIn(d.expectedKWh, 0, 10000)
        && optionalNumberIn(d, 'clearShare', 0, 1);
    }

    function validScheduleSlot(d) {
      return d.weekday is int && d.weekday >= 1 && d.weekday <= 7
        && d.startMinute is int && d.startMinute >= 0 && d.startMinute < 1440
        && d.endMinute is int && d.endMinute >= 0 && d.endMinute < 1440;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /systems/{systemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSystem(request.resource.data);

        // appliances, outages, schedule and solarLogs are validated; other
        // per-system logs (healthSnapshots, weatherCache) are owner-only.
        match /{collection}/{docId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && (collection != 'appliances' || validAppliance(request.resource.data))
            && (collection != 'outages' || validOutage(request.resource.data))
            && (collection != 'schedule' || validScheduleSlot(request.resource.data))
            && (collection != 'solarLogs' || validSolarLog(request.resource.data));
        }
      }

      match /chats/{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Reference data: written only by the admin SDK (seedCatalog).
    match /batteryCatalog/{productId} {
      allow read: if request.auth != null;
    }
    match /config/{docId} {
      allow read: if request.auth != null;
    }

    // aiUsage/{uid} (assistant daily limit) has no rule on purpose: only the
    // assistantChat function writes it, so users can't reset their count.
  }
}
