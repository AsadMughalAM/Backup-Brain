{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "paths": {
      "@app/*": ["../app/*"]
    }
  },
  "include": ["src", "scripts", "remotion.config.ts", "remotion.webpack.ts"]
}
